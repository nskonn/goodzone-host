{
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    },
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["DOM", "ESNext"],
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "baseUrl": "./src",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "pages/*": ["pages/*"],
            "routing/*": ["routing/*"],
            "home/*": ["home/*"], // микрофронтенд home
            "shared/*": ["shared/*"]
        }
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src", "tools/**/*.ts", "webpack.config.ts"]
}
